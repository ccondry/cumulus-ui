{
  "name": "vertical-toolbox-ui",
  "version": "2024.11.20",
  "description": "dCloud Toolbox UI for configuring dCloud Contact Center demo branding",
  "repository": "dcloud-collab/cumulus-toolbox-ui",
  "license": "UNLICENSED",
  "author": {
    "name": "Coty Condry",
    "email": "ccondry@cisco.com"
  },
  "keywords": [
    "cisco",
    "finesse",
    "gadget",
    "administration",
    "panel"
  ],
  "private": true,
  "scripts": {
    "build": "rollup -c",
    "dev": "npm run serve",
